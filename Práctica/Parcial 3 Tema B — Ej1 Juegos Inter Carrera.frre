/*
3er Parcial 2025 — Comisión C — TEMA B — Ejercicio 1 (3 pts): Juegos Inter Carrera 2025

La Secretaría de Asuntos Estudiantiles organiza los Juegos Inter Carrera 2025, con equipos
de las carreras IQ, ISI, IEM, TUP y LAR. Disciplinas: Fútbol (F), Básquet (B), Vóley (V),
Tenis de mesa (T) y Ajedrez (A). Un mismo equipo puede participar en varias disciplinas.

Al final se sortean premios. Cada equipo acumula "chances":
  1. Por participar en el evento: +5 chances.
  2. Por cada disciplina en la que participó el equipo: +3 chances.
  3. Según la posición final del equipo en cada disciplina:
       Campeón: +20 · Subcampeón: +12 · Tercer puesto: +8 · Participación sin podio: +2

Archivos:
  INSCRIPCIONES, secuencial ordenado por cod_equipo:
    cod_equipo | nombre_equipo | carrera (IQ/ISI/IEM/TUP/LAR)
  RESULTADOS, indexado por cod_equipo:
    cod_equipo | posicion_disciplinas
  posicion_disciplinas es un vector de 5 elementos con el resultado del equipo en cada
  disciplina (1: Fútbol, 2: Básquet, 3: Vóley, 4: Tenis de mesa, 5: Ajedrez).
  Valores posibles: "Campeón", "Subcampeón", "Tercero", "Sin podio" o "NP" (no participó).

Se pide:
  1. Generar una lista simplemente enlazada con nombre_equipo, carrera, total_chances,
     ordenada de mayor a menor por total_chances.
  2. Mostrar por pantalla, por cada equipo, la cantidad de disciplinas en las que participó
     y en cuántas salió campeón.


CÓMO SE ARMA (el mismo patrón que los otros ejercicios 1, ver "Patrón — Ejercicio 1 de listas")
  - Recorro el secuencial UNA vez. Cada registro es un equipo.
  - Por cada equipo: consulto sus resultados en el indexado (clave -> LEER -> SI EXISTE),
    recorro el vector de 5 posiciones sumando chances y contando, muestro el punto 2 y
    cargo el nodo ordenado en la lista simple.
  - El punto 2 es "por cada equipo": se muestra adentro del ciclo, no al final.
*/

// Lo que asumo, porque la consigna no lo aclara:
// 1) Si un equipo está inscripto pero no tiene registro en RESULTADOS, participó del
//    evento (+5) y de ninguna disciplina. Lo aviso y lo cargo igual en la lista.
// 2) A igual total_chances, el que se lee después queda después.

ACCION JuegosInterCarrera ES
    AMBIENTE
        inscripcion = REGISTRO
            cod_equipo: entero;
            nombre_equipo: AN(50);
            carrera: AN(3);                                     // IQ, ISI, IEM, TUP, LAR
        FIN_REGISTRO

        resultado = REGISTRO
            cod_equipo: entero;
            posicion_disciplinas: ARREGLO[1..5] de AN(10);      // F, B, V, T, A
        FIN_REGISTRO

        inscripciones: ARCHIVO de inscripcion ordenado por cod_equipo;
        resultados: ARCHIVO de resultado INDEXADO por cod_equipo;
        reg_ins: inscripcion;
        reg_res: resultado;

        // la lista simple que se genera
        NODO = REGISTRO
            nombre_equipo: AN(50);
            carrera: AN(3);
            total_chances: entero;
            prox: Puntero a NODO;
        FIN_REGISTRO

        PRIM, P, Q, ANT: Puntero a NODO;

        i, chances, cant_part, cant_camp: entero;
        pos: AN(10);

    PROCESO
        PRIM := NIL;

        ABRIR E/(inscripciones);
        ABRIR E/(resultados);

        ESCRIBIR("Equipo | Disciplinas en que participó | Campeón en");
        LEER(inscripciones, reg_ins);
        MIENTRAS NFDA(inscripciones) HACER
            chances := 5;                                       // por participar en el evento
            cant_part := 0;
            cant_camp := 0;

            // --- los resultados no están en la inscripción: se consulta el indexado ---
            reg_res.cod_equipo := reg_ins.cod_equipo;
            LEER(resultados, reg_res);
            SI EXISTE ENTONCES
                PARA i := 1 HASTA 5 HACER
                    pos := reg_res.posicion_disciplinas[i];
                    SI pos <> "NP" ENTONCES
                        cant_part := cant_part + 1;
                        chances := chances + 3;                 // por participar en la disciplina
                        SI pos = "Campeón" ENTONCES
                            chances := chances + 20;
                            cant_camp := cant_camp + 1;
                        SINO
                            SI pos = "Subcampeón" ENTONCES
                                chances := chances + 12;
                            SINO
                                SI pos = "Tercero" ENTONCES
                                    chances := chances + 8;
                                SINO                            // "Sin podio"
                                    chances := chances + 2;
                                FIN_SI
                            FIN_SI
                        FIN_SI
                    FIN_SI
                FIN_PARA
            SINO
                ESCRIBIR("(", reg_ins.nombre_equipo, " no tiene resultados cargados: solo suma las 5 chances del evento)");
            FIN_SI

            // 2) por cada equipo
            ESCRIBIR(reg_ins.nombre_equipo, " | ", cant_part, " | ", cant_camp);

            // --- armar el nodo ---
            NUEVO(Q);
            *Q.nombre_equipo := reg_ins.nombre_equipo;
            *Q.carrera := reg_ins.carrera;
            *Q.total_chances := chances;

            // --- insertarlo ordenado de mayor a menor (recorrido con ANT y P, filmina 8) ---
            P := PRIM;
            ANT := NIL;
            MIENTRAS (P <> NIL) Y (*P.total_chances >= *Q.total_chances) HACER
                ANT := P;
                P := *P.prox;
            FIN_MIENTRAS
            SI ANT = NIL ENTONCES           // CASOS 1 y 2: lista vacía o antes del primero
                PRIM := Q;
            SINO                            // CASOS 3 y 4: en el medio o al final
                *ANT.prox := Q;
            FIN_SI
            *Q.prox := P;                   // P es NIL en los casos 1 y 4

            LEER(inscripciones, reg_ins);
        FIN_MIENTRAS

        CERRAR(inscripciones);
        CERRAR(resultados);

        // 1) la lista generada (de mayor a menor por total_chances)
        ESCRIBIR("");
        ESCRIBIR("Equipo | Carrera | Total de chances");
        P := PRIM;
        MIENTRAS P <> NIL HACER
            ESCRIBIR(*P.nombre_equipo, " | ", *P.carrera, " | ", *P.total_chances);
            P := *P.prox;
        FIN_MIENTRAS
FIN_ACCION
